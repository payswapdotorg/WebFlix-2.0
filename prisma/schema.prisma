// WebFlix 2.0 — unified domain schema (WFX2-B boot ∪ WFX2-W watch, lead merge).
// Canonical model names from the boot lane; watch-lane additive fields/models
// merged per evidence/wfx2w/SCHEMA-MERGE.md (union law).
// NOTE: SQLite does not support Prisma enums — enumerated fields are String
// with allowed values documented here and union-typed in src/lib/types.ts.
// NOTE: NotInterested (boot) was unified into VideoSignal (watch) — the
// extensible kind field covers "not_interested"; one signal store for the
// same kebab action on every surface.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Set by every script (env-drift protection): dev/test/seeds each pin
  // their own db file. Defaults documented in .env.example.
  url = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  handle      String   @unique
  name        String
  avatarUrl   String
  bannerUrl   String?
  description String?
  createdAt   DateTime @default(now())

  subscriptions  Subscribe[]
  videoLikes     VideoLike[]
  commentLikes   CommentLike[]
  playlists      Playlist[]
  notifications  Notification[]
  memberships    Membership[]
  viewEvents     ViewEvent[]
  watchDailyStats WatchDailyStat[]
  comments       Comment[]
  videoReports   VideoReport[]
  videoSignals   VideoSignal[]
  liveChat       LiveChatMessage[]
  ownedChannels  Channel[]    @relation("ChannelOwner")
  clips          Clip[]
  netflixMyList  NetflixMyListItem[]
  netflixWatchEvents NetflixWatchEvent[]
  liveRoomsOwned LiveRoom[] @relation("LiveRoomHost")
}

model Channel {
  id              String   @id @default(cuid())
  handle          String   @unique
  name            String
  avatarUrl       String
  bannerUrl       String?
  description     String?
  verified        Boolean  @default(false)
  subscriberCount Int      @default(0)
  ownerId         String?  @unique
  createdAt       DateTime @default(now())

  owner           User?            @relation("ChannelOwner", fields: [ownerId], references: [id])
  videos          Video[]
  subscribers     Subscribe[]
  membershipTiers MembershipTier[]
  notifications   Notification[]   @relation("NotificationSourceChannel")
}

model Subscribe {
  userId    String
  channelId String
  // "off" | "personalized" | "all"
  bell      String   @default("personalized")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([userId])
}

model Video {
  id            String    @id @default(cuid())
  channelId     String
  title         String
  description   String    @default("")
  thumbnailUrl  String
  videoUrl      String
  durationSec   Int       @default(0)
  views         Int       @default(0)
  likes         Int       @default(0)
  dislikes      Int       @default(0)
  // "public" | "unlisted" | "private"
  visibility    String    @default("public")
  isMembersOnly Boolean   @default(false)
  membersTier   String?
  category      String    @default("Misc")
  isShort       Boolean   @default(false)
  isLive        Boolean   @default(false)
  premieredAt   DateTime?
  // "clear" | "flagged" (report queue state; the studio moderation lane builds on this)
  moderation    String    @default("clear")
  createdAt     DateTime  @default(now())

  channel        Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videoLikes     VideoLike[]
  viewEvents     ViewEvent[]
  comments       Comment[]
  playlistItems  PlaylistItem[]
  notifications  Notification[]
  liveChat       LiveChatMessage[]
  thumbnailTests ThumbnailTest[]
  transcript     TranscriptCue[]
  reports        VideoReport[]
  signals        VideoSignal[]

  @@index([channelId])
  @@index([category])
  @@index([isShort])
  @@index([isLive])
  @@index([views])
  @@index([createdAt])
}

model VideoLike {
  userId    String
  videoId   String
  // "like" | "dislike"
  value     String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([userId])
}

model ViewEvent {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  watchedSec      Int      @default(0)
  lastPositionSec Int      @default(0)
  at              DateTime @default(now())
  // `at` is the view-dedupe anchor (1h window) — never bumped by progress saves.
  // One progress row per user+video (upsert in the progress route).

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId, at])
  @@index([videoId])
  @@index([videoId, userId, at])
}

// WFX2-P7-AN — the daily watch-time aggregation (one row per user+UTC-day).
// The ONLY writer is the progress-service autosave path (saveProgress): the
// increment is the autosave's cumulative delta. The /api/view dedupe ping
// NEVER touches this table (view-dedupe semantics, not watch-time).
model WatchDailyStat {
  id            String   @id @default(cuid())
  userId        String
  // "YYYY-MM-DD" UTC date key
  day           String
  sec           Int      @default(0)
  videosWatched Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

model Comment {
  id               String   @id @default(cuid())
  videoId          String
  userId           String
  parentId         String?
  body             String
  likes            Int      @default(0)
  heartedByCreator Boolean  @default(false)
  pinned           Boolean  @default(false)
  // "approved" | "held" | "flagged" | "rejected" | "deleted"
  // ("deleted" is the soft state that powers the delete-undo toast;
  //  "shadow" marks a live-YouTube-comment anchor row — an FK anchor that
  //  NEVER renders: every read path filters moderation:"approved" only,
  //  the live payload owns the parent's rendering — WFX2-P6-CR)
  moderation       String   @default("approved")
  reportedBy       Int      @default(0)
  edited           Boolean  @default(false)
  createdAt        DateTime @default(now())

  video      Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Comment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]    @relation("CommentThread")
  commentLikes CommentLike[]

  @@index([videoId])
  @@index([userId])
  @@index([videoId, moderation, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  // "like" | "dislike"
  value     String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model Playlist {
  id           String   @id @default(cuid())
  userId       String
  title        String
  // "public" | "unlisted" | "private"
  visibility   String   @default("private")
  isWatchLater Boolean  @default(false)
  createdAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId])
}

model PlaylistItem {
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([playlistId, videoId])
  @@index([videoId])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  sourceChannelId String
  // "video" | "live" | "post" | "reply"
  kind            String   @default("video")
  title           String
  body            String
  videoId         String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceChannel Channel @relation("NotificationSourceChannel", fields: [sourceChannelId], references: [id], onDelete: Cascade)
  video         Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model MembershipTier {
  id         String   @id @default(cuid())
  channelId  String
  name       String
  priceCents Int
  perks      String   @default("")

  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([channelId, name])
}

model Membership {
  userId  String
  tierId  String
  since   DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([userId, tierId])
}

model LiveChatMessage {
  id      String   @id @default(cuid())
  videoId String
  userId  String
  body    String
  at      DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, at])
}

model ThumbnailTest {
  id          String   @id @default(cuid())
  videoId     String
  // JSON string: [{ url, impressions, clicks }]
  variants    String
  winnerIdx   Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model TranscriptCue {
  id       String @id @default(cuid())
  videoId  String
  video    Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  startSec Int
  endSec   Int
  text     String

  @@index([videoId, startSec])
}

model VideoReport {
  id        String   @id @default(cuid())
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

// Personalization / moderation signals — the single kebab-action store.
model VideoSignal {
  id        String   @id @default(cuid())
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "not_interested" | "dont_recommend_channel"
  kind      String
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

// P23-A — WebFlix-local clips (the Clip tab's create). The clip's [start,
// end) window rides the source video id (a YouTube id on the watch surface);
// the row records the creator for the clip page's attribution panel
// (youtube.com's clipAttributionRenderer: clip title, clip author, created).
// NOTE (honest scope, measured 2026-10-17): youtube.com's own web client has
// REMOVED the clip-create seam (the web_watch_remove_clip_create_panel flag;
// no /youtubei/v1/clip endpoint in the current web bundle), so a WebFlix clip
// is a WebFlix-local share window — it never claims a YouTube-side clip
// object. Remote YouTube clip ids (Ug… postIds) resolve through the read
// family (src/lib/youtube/clips.ts), never this table.
model Clip {
  id        String   @id @default(cuid())
  // the SOURCE video id as the watch surface knows it (a YouTube video id)
  videoId   String
  title     String
  startSec  Int
  endSec    Int
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([videoId])
}

// ---------------------------------------------------------------------------
// P42-NETFLIX-SOURCE — the first second-source lane (ADR 0002). ADDITIVE ONLY:
// every youtube surface stays byte-identical. NetflixTitle is the catalog
// MIRROR (the search index the Top 10 pools feed on every refresh — the live
// pools stay the source of truth); NetflixMyListItem is the viewer's
// WebFlix-LOCAL "My Netflix List" (Netflix's own list API needs a Netflix
// login — ADR 0002 §5 forbids that, so the list lives here, honestly local).
// NOTE: SQLite carries no list primitives — countryRanks is a "CC:rank" CSV.
model NetflixTitle {
  netflixId      Int      @id
  title          String
  // "movie" | "series"
  kind           String
  synopsis       String   @default("")
  releaseYear    Int?
  maturityRating String?
  posterUrl      String?
  backdropUrl    String?
  logoUrl        String?
  weeklyRank     Int?
  allTimeRank    Int?
  weeksInTop10   Int?
  weeklyHoursViewed BigInt?
  weeklyViews    BigInt?
  // YYYY-MM-DD (weekly pools); null = all-time
  weekEndDate    String?
  pool           String?
  isPlayable     Boolean  @default(true)
  // "US:1,GB:4,…" (ISO code → rank in that country's Top 10)
  countryRanks   String   @default("")
  updatedAt      DateTime @updatedAt

  myListItems NetflixMyListItem[]
  watchEvents NetflixWatchEvent[]

  @@index([title])
  @@index([kind])
}

model NetflixMyListItem {
  userId    String
  netflixId Int
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title NetflixTitle @relation(fields: [netflixId], references: [netflixId], onDelete: Cascade)

  @@id([userId, netflixId])
  @@index([userId])
}

// P49-CONTINUE-WATCHING — the viewer's WebFlix-LOCAL play history for Netflix
// titles (ADR 0002 §5: no Netflix credentials anywhere, so playback memory
// lives here, honestly local — the same law as NetflixMyListItem). One row
// per (viewer, title): the hub's "Continue Watching" rail reads it, the
// watch lane's kick and the hand-off deep link write it. playCount is the
// honest "you pressed play N times"; NO fake percent-watched (the streamed
// player gives WebFlix no position, and a fabricated bar would be a lie).
model NetflixWatchEvent {
  userId       String
  netflixId    Int
  lastPlayedAt DateTime @default(now())
  playCount    Int      @default(1)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title NetflixTitle @relation(fields: [netflixId], references: [netflixId], onDelete: Cascade)

  @@id([userId, netflixId])
  @@index([userId, lastPlayedAt])
}

// ═══════════════════════════════════════════════════════════════════
// WFX2-LIVE-PLATFORM-1 — first-party WebFlix LIVE (issue #2).
// Frozen Phase 1 contracts (docs/plans/work-orders/WFX2-LIVE-PLATFORM-1.md §6).
// One LiveRoom = one broadcast lifecycle in Phase 1; LiveSession carries the
// provider-scoped transport; participants are identity rows, never
// credentials. Enumerated fields are String (the no-enum SQLite law) with
// allowed values in comments, union-typed in src/lib/live/types.ts.
// Production note: the Vercel build pushes THIS model set to Neon PostgreSQL
// via the schema.postgres.prisma twin (byte-equivalent modulo provider).
// ═══════════════════════════════════════════════════════════════════

// The canonical room identity + policy. status: "idle" | "live" | "ended".
// visibility: "public" | "unlisted" (Phase 1); audience/age gates land later.
model LiveRoom {
  id         String   @id @default(cuid())
  hostId     String
  title      String
  status     String   @default("idle")
  visibility String   @default("public")
  // Phase 2 room policy — server-enforced interaction gates (explicit
  // columns, no JSON blob; the no-catch-all law). Moderators/host mutate
  // them only through the audited moderation route.
  chatEnabled      Boolean @default(true)
  reactionsEnabled Boolean @default(true)
  slowModeSeconds  Int     @default(0)
  // Phase 3 room policy — the guest-stage and gift gates (same law).
  guestsEnabled    Boolean @default(true)
  giftsEnabled     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host     User          @relation("LiveRoomHost", fields: [hostId], references: [id])
  sessions LiveSession[]
  invites  LiveInvite[]

  @@index([status])
  @@index([hostId])
}

// One scheduled/actual broadcast lifecycle. status: "starting" | "live" |
// "reconnecting" | "ended". providerRoomId is the provider-side room NAME —
// a routing identity, never a secret (tokens are minted server-side).
// endReason: "host" | "provider-webhook" | "timeout" | null while live.
model LiveSession {
  id             String    @id @default(cuid())
  roomId         String
  provider       String    @default("livekit")
  providerRoomId String
  status         String    @default("starting")
  startedAt      DateTime?
  endedAt        DateTime?
  endReason      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Phase 4: the presence-time concurrent viewer peak — the heartbeat path
  // raises it, analytics summarizes it. APPROXIMATE by the presence law
  // (never a billing/financial fact).
  peakViewers   Int     @default(0)

  room         LiveRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants LiveParticipant[]
  replay       LiveReplayAsset?
  analytics    LiveAnalyticsSnapshot?

  @@unique([provider, providerRoomId])
  @@index([roomId])
  @@index([status])
}

// Session membership for a WebFlix identity. role: "host" | "guest" | "viewer".
// state: "connected" | "disconnected" | "removed". Viewer counts are derived
// from these rows and are APPROXIMATE — never a billing/financial fact.
model LiveParticipant {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  role      String
  state     String   @default("connected")
  joinedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// Host-approved invitation/request state for publisher roles (guests land in
// Phase 3; the table + authorization path freeze now). status: "pending" |
// "accepted" | "declined" | "expired" | "cancelled".
model LiveInvite {
  id        String   @id @default(cuid())
  roomId    String
  inviteeId String
  inviterId String
  role      String   @default("guest")
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([inviteeId, status])
}

// ═══════════════════════════════════════════════════════════════════
// WFX2-LIVE-PLATFORM-1 Phase 2 — interaction, safety and events (issue #2).
// Same laws as Phase 1: String enums (allowed values in comments), NO FKs
// on high-volume interaction rows (sender/actor ids are the shadow-user
// seam ids — display fields resolve at read time so user deletion can
// never cascade-erase room history / the moderation audit trail), and
// every side effect carries an idempotency key.
// ═══════════════════════════════════════════════════════════════════

// Durable room chat. kind: "chat" | "system" | "announcement". The seq
// autoincrement is the STRICT ordering + replay cursor (work order §4C
// "exact message ordering semantics"); (sessionId, senderId,
// clientMessageId) is the duplicate-suppression law. deletedAt/deletedBy
// tombstone moderation removals — the row (and thus the audit trail)
// survives; the API renders deleted messages as tombstones.
model LiveRoomMessage {
  seq             Int       @id @default(autoincrement())
  id              String    @unique @default(cuid())
  roomId          String
  sessionId       String
  senderId        String
  clientMessageId String
  body            String
  kind            String    @default("chat")
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime  @default(now())

  @@unique([sessionId, senderId, clientMessageId])
  @@index([sessionId, seq])
  @@index([roomId, createdAt])
}

// One client-side batching window (400ms law) of tap reactions, accepted
// server-side with a per-batch count cap. kind: "heart" (Phase 2 v1).
// (sessionId, senderId, clientBatchId) is the retry/duplicate law. Totals
// are always SUM-ed server-side — never client-supplied.
model LiveReactionBatch {
  id            String   @id @default(cuid())
  roomId        String
  sessionId     String
  senderId      String
  clientBatchId String
  kind          String   @default("heart")
  count         Int
  createdAt     DateTime @default(now())

  @@unique([sessionId, senderId, clientBatchId])
  @@index([sessionId, createdAt])
}

// Persistent moderator grant (survives sessions, unlike participant rows).
// Revocation keeps the row with revokedAt/revokedBy set — the grant ledger
// stays complete for audit.
model LiveRoomModerator {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  grantedBy String
  revokedAt DateTime?
  revokedBy String?
  createdAt DateTime  @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

// The moderation AUDIT TRAIL (work order §4I). action: "delete-message" |
// "mute" | "unmute" | "ban" | "unban" | "slow-mode" | "chat-enable" |
// "chat-disable". Mute is timed via expiresAt; mute/ban STATE is derived
// from this table (latest action wins) so state and audit can never drift.
model LiveModerationAction {
  id        String    @id @default(cuid())
  roomId    String
  sessionId String?
  actorId   String
  targetId  String?
  action    String
  reason    String?
  messageId String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([roomId, createdAt])
  @@index([roomId, targetId, createdAt])
}

// Viewer reports. reason: "spam" | "harassment" | "inappropriate" |
// "other". status: "open" | "reviewed" | "dismissed". Visible to the room
// host; platform-wide queue lands with the admin surface (Phase 3+).
model LiveReport {
  id         String   @id @default(cuid())
  roomId     String
  sessionId  String?
  reporterId String
  targetId   String?
  messageId  String?
  reason     String
  detail     String?
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([roomId, status])
  @@index([reporterId, createdAt])
}

// Server-authoritative polls (work order §4C: counts are server-computed).
// status: "open" | "closed". One vote per (poll, user); changing a vote is
// an UPDATE of that unique row, never a second row.
model LivePoll {
  id          String    @id @default(cuid())
  roomId      String
  sessionId   String
  question    String
  createdById String
  status      String    @default("open")
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  options LivePollOption[]
  votes   LivePollVote[]

  @@index([sessionId, createdAt])
}

model LivePollOption {
  id       String @id @default(cuid())
  pollId   String
  label    String
  position Int

  poll  LivePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes LivePollVote[]

  @@index([pollId, position])
}

model LivePollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   LivePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option LivePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

// Q&A — viewers ask; host/moderators answer or hide. hiddenAt is the
// moderation tombstone (the question stays in the audit set, never listed
// publicly once hidden).
model LiveQuestion {
  id         String    @id @default(cuid())
  roomId     String
  sessionId  String
  askerId    String
  body       String
  answeredAt DateTime?
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId, createdAt])
  @@index([roomId, hiddenAt])
}

// Scheduled WebFlix LIVE events (work order §4H). status: "scheduled" |
// "canceled" | "completed". roomId links the broadcast once it starts.
model LiveEvent {
  id           String   @id @default(cuid())
  creatorId    String
  title        String
  description  String?
  scheduledFor DateTime
  status       String   @default("scheduled")
  roomId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations EventRegistration[]

  @@index([status, scheduledFor])
  @@index([creatorId])
}

// Event registrations — one per (event, user), cancel = row delete
// (registration count derives from rows, never client claims).
model EventRegistration {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

// ═══════════════════════════════════════════════════════════════════
// WFX2-LIVE-PLATFORM-1 Phase 3 — guests, matches, non-monetary gifts
// (issue #2). Same laws as Phase 1/2: String enums (allowed values in
// comments), NO FKs on high-volume interaction rows (sender/actor ids
// are shadow-user seam ids), and every side effect carries an
// idempotency key. Match scoring is APPEND-ONLY (LiveScoreEvent): the
// score state derives from validated events — never client-supplied.
// ═══════════════════════════════════════════════════════════════════

// A match between ACTIVE stage participants (host/guest roles) of ONE
// session. kind: "solo" (exactly 1 member per team) | "team" (up to
// MATCH_TEAM_SIZE_MAX per team). status: "active" | "ended" |
// "cancelled". The scoring policy is explicit columns (which inputs
// count), never a JSON blob. One ACTIVE match per session (guarded in
// the domain service); the result derives ONLY from LiveScoreEvent rows.
model LiveMatch {
  id              String    @id @default(cuid())
  roomId          String
  sessionId       String
  createdById     String
  kind            String    @default("solo")
  status          String    @default("active")
  durationSeconds Int
  reactionsScore  Boolean   @default(true)
  giftsScore      Boolean   @default(true)
  startedAt       DateTime  @default(now())
  endsAt          DateTime
  endedAt         DateTime?
  endReason       String?   // "host" | "timeout" (lazy wall-clock expiry)
  winnerTeamId    String?   // null on a draw or a cancelled match
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teams       LiveMatchTeam[]
  scoreEvents LiveScoreEvent[]
  snapshots   LiveScoreSnapshot[]

  @@index([sessionId, status])
  @@index([roomId, createdAt])
}

// One side of a match. label: "A" | "B" (UI may present any display
// name; the ledger stores id + position). position: 0 | 1.
model LiveMatchTeam {
  id       String @id @default(cuid())
  matchId  String
  label    String
  position Int

  match   LiveMatch         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members LiveMatchMember[]

  @@index([matchId, position])
}

// Match roster membership. One team per (match, user) — the unique row
// is the anti-double-roster law. leftAt records a mid-match leave;
// banked LiveScoreEvent rows stand (the ledger never rewrites history).
model LiveMatchMember {
  id        String    @id @default(cuid())
  matchId   String
  teamId    String
  userId    String
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  team LiveMatchTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([teamId])
}

// THE append-only scoring ledger (work order §4E). source: "reaction" |
// "gift". (matchId, clientEventId) is the duplicate-delivery law — a
// replayed batch/gift returns the existing row and NEVER double-scores.
// Amounts are validated server-side against the frozen caps; teamId and
// actorId derive from match membership / validated intent at ingestion.
model LiveScoreEvent {
  id            String   @id @default(cuid())
  matchId       String
  teamId        String
  actorId       String
  source        String
  amount        Int
  clientEventId String
  linkId        String?  // the reaction batch id / gift event id (trace)
  createdAt     DateTime @default(now())

  match LiveMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, clientEventId])
  @@index([matchId, createdAt])
}

// Deterministic, auditable standings taken at a moment. kind: "final"
// (one per team when the match ends — the result of record) |
// "periodic" (reserved). Live standings at read time are
// SUM(LiveScoreEvent); the final snapshot freezes them at end so the
// recorded result can never drift afterwards.
model LiveScoreSnapshot {
  id        String   @id @default(cuid())
  matchId   String
  teamId    String
  teamLabel String
  kind      String   @default("final")
  amount    Int
  takenAt   DateTime @default(now())

  match LiveMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, takenAt])
}

// The ORIGINAL WebFlix gift catalogue (work order §4F/§9: original
// names/mechanics, no TikTok labels or art). v1 is NON-MONETARY dev
// gifting: priceCredits are integer DEV credits with ZERO cash value
// (the UI must say so) used for match scoring and the abuse caps —
// never a money amount; the wallet/ledger lands with the money gate.
// id is a stable slug. animationKind: "burst" | "float" | "sparkle" | "wave".
model GiftCatalogItem {
  id            String  @id
  name          String
  animationKind String
  priceCredits  Int
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
}

// The send intent — (sessionId, senderId, clientRequestId) is the
// duplicate-suppression law. v1 rows are always status "accepted"
// (hard validation failures answer errors and write nothing; the
// status/rejectReason columns exist for the Phase 4/5 wallet-rejection
// path). totalCredits is server-computed (quantity × catalogue price).
model GiftIntent {
  id              String   @id @default(cuid())
  roomId          String
  sessionId       String
  senderId        String
  giftItemId      String
  quantity        Int
  clientRequestId String
  status          String   @default("accepted")
  rejectReason    String?
  totalCredits    Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([sessionId, senderId, clientRequestId])
  @@index([sessionId, createdAt])
}

// The durable room gift event — the feed row and the match-scoring
// source. recipientId is the room HOST by law (v1 gifting targets the
// creator). matchId/matchTeamId are set only when an ACTIVE match with
// gift scoring accepted the send against that team. giftName is a
// denormalized audit snapshot (catalogue rows are never renamed).
model GiftEvent {
  id           String   @id @default(cuid())
  intentId     String   @unique
  roomId       String
  sessionId    String
  senderId     String
  recipientId  String
  giftItemId   String
  giftName     String
  quantity     Int
  totalCredits Int
  matchId      String?
  matchTeamId  String?
  createdAt    DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([roomId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// WFX2-LIVE-PLATFORM-1 Phase 4 — replays and creator analytics (§4H).
// Same laws: String enums (allowed values in comments), lifecycle rows
// cascade with their session, every derived number is recomputed from
// durable rows (never client-claimed), and the replay object is stored
// WITHOUT an absolute URL — playback URLs are issued at read time.
// ═══════════════════════════════════════════════════════════════════

// One replay asset per session (v1). sink: "host-capture" |
// "provider-egress" (ADR-0008's two sinks behind ONE lifecycle). status:
// "recording" | "processing" | "ready" | "failed" | "expired".
// visibility: "inherit" | "public" | "unlisted" | "hidden" (inherit follows
// the room's visibility). storageKey names the object in the replay storage
// seam — never a provider URL, never a secret. durationMs is the
// RECORDER-reported media duration: advisory metadata, never a billing or
// financial fact (the authoritative duration derives from the session
// window). retentionExpiresAt is the retention law (REPLAY_RETENTION_DAYS);
// a lazy sweep on read purges expired objects and marks the row "expired".
model LiveReplayAsset {
  id                 String    @id @default(cuid())
  sessionId          String    @unique
  roomId             String
  sink               String    @default("host-capture")
  status             String    @default("recording")
  requestedById      String
  mimeType           String?
  storageKey         String?
  sizeBytes          Int?
  durationMs         Int?
  visibility         String    @default("inherit")
  error              String?
  recordingStartedAt DateTime  @default(now())
  stoppedAt          DateTime?
  readyAt            DateTime?
  retentionExpiresAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([status, readyAt])
}

// The creator analytics snapshot — DERIVED from durable rows only
// (participants / messages / reaction batches / gift events / matches plus
// the session window). Recomputed server-side on every host read
// (idempotent upsert): the snapshot can never drift from the rows it
// summarizes. peakViewers rides the LiveSession column (presence-time max,
// raised by the heartbeat path — the only concurrent-peak fact that exists).
model LiveAnalyticsSnapshot {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  roomId         String
  durationMs     Int      @default(0)
  peakViewers    Int      @default(0)
  uniqueViewers  Int      @default(0)
  chatMessages   Int      @default(0)
  reactionHearts Int      @default(0)
  giftEvents     Int      @default(0)
  giftCredits    Int      @default(0)
  matchesRun     Int      @default(0)
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([roomId])
}
