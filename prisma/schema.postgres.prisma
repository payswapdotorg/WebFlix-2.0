// WebFlix 2.0 — unified domain schema (WFX2-B boot ∪ WFX2-W watch, lead merge).
// Canonical model names from the boot lane; watch-lane additive fields/models
// merged per evidence/wfx2w/SCHEMA-MERGE.md (union law).
// NOTE: SQLite does not support Prisma enums — enumerated fields are String
// with allowed values documented here and union-typed in src/lib/types.ts.
// NOTE: NotInterested (boot) was unified into VideoSignal (watch) — the
// extensible kind field covers "not_interested"; one signal store for the
// same kebab action on every surface.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Set by every script (env-drift protection): dev/test/seeds each pin
  // their own db file. Defaults documented in .env.example.
  url = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  handle      String   @unique
  name        String
  avatarUrl   String
  bannerUrl   String?
  description String?
  createdAt   DateTime @default(now())

  subscriptions  Subscribe[]
  videoLikes     VideoLike[]
  commentLikes   CommentLike[]
  playlists      Playlist[]
  notifications  Notification[]
  memberships    Membership[]
  viewEvents     ViewEvent[]
  watchDailyStats WatchDailyStat[]
  comments       Comment[]
  videoReports   VideoReport[]
  videoSignals   VideoSignal[]
  liveChat       LiveChatMessage[]
  ownedChannels  Channel[]    @relation("ChannelOwner")
  clips          Clip[]
  netflixMyList  NetflixMyListItem[]
  netflixWatchEvents NetflixWatchEvent[]
  liveRoomsOwned LiveRoom[] @relation("LiveRoomHost")
}

model Channel {
  id              String   @id @default(cuid())
  handle          String   @unique
  name            String
  avatarUrl       String
  bannerUrl       String?
  description     String?
  verified        Boolean  @default(false)
  subscriberCount Int      @default(0)
  ownerId         String?  @unique
  createdAt       DateTime @default(now())

  owner           User?            @relation("ChannelOwner", fields: [ownerId], references: [id])
  videos          Video[]
  subscribers     Subscribe[]
  membershipTiers MembershipTier[]
  notifications   Notification[]   @relation("NotificationSourceChannel")
}

model Subscribe {
  userId    String
  channelId String
  // "off" | "personalized" | "all"
  bell      String   @default("personalized")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([userId])
}

model Video {
  id            String    @id @default(cuid())
  channelId     String
  title         String
  description   String    @default("")
  thumbnailUrl  String
  videoUrl      String
  durationSec   Int       @default(0)
  views         Int       @default(0)
  likes         Int       @default(0)
  dislikes      Int       @default(0)
  // "public" | "unlisted" | "private"
  visibility    String    @default("public")
  isMembersOnly Boolean   @default(false)
  membersTier   String?
  category      String    @default("Misc")
  isShort       Boolean   @default(false)
  isLive        Boolean   @default(false)
  premieredAt   DateTime?
  // "clear" | "flagged" (report queue state; the studio moderation lane builds on this)
  moderation    String    @default("clear")
  createdAt     DateTime  @default(now())

  channel        Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videoLikes     VideoLike[]
  viewEvents     ViewEvent[]
  comments       Comment[]
  playlistItems  PlaylistItem[]
  notifications  Notification[]
  liveChat       LiveChatMessage[]
  thumbnailTests ThumbnailTest[]
  transcript     TranscriptCue[]
  reports        VideoReport[]
  signals        VideoSignal[]

  @@index([channelId])
  @@index([category])
  @@index([isShort])
  @@index([isLive])
  @@index([views])
  @@index([createdAt])
}

model VideoLike {
  userId    String
  videoId   String
  // "like" | "dislike"
  value     String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([userId])
}

model ViewEvent {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  watchedSec      Int      @default(0)
  lastPositionSec Int      @default(0)
  at              DateTime @default(now())
  // `at` is the view-dedupe anchor (1h window) — never bumped by progress saves.
  // One progress row per user+video (upsert in the progress route).

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId, at])
  @@index([videoId])
  @@index([videoId, userId, at])
}

// WFX2-P7-AN — the daily watch-time aggregation (one row per user+UTC-day).
// The ONLY writer is the progress-service autosave path (saveProgress): the
// increment is the autosave's cumulative delta. The /api/view dedupe ping
// NEVER touches this table (view-dedupe semantics, not watch-time).
model WatchDailyStat {
  id            String   @id @default(cuid())
  userId        String
  // "YYYY-MM-DD" UTC date key
  day           String
  sec           Int      @default(0)
  videosWatched Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

model Comment {
  id               String   @id @default(cuid())
  videoId          String
  userId           String
  parentId         String?
  body             String
  likes            Int      @default(0)
  heartedByCreator Boolean  @default(false)
  pinned           Boolean  @default(false)
  // "approved" | "held" | "flagged" | "rejected" | "deleted"
  // ("deleted" is the soft state that powers the delete-undo toast;
  //  "shadow" marks a live-YouTube-comment anchor row — an FK anchor that
  //  NEVER renders: every read path filters moderation:"approved" only,
  //  the live payload owns the parent's rendering — WFX2-P6-CR)
  moderation       String   @default("approved")
  reportedBy       Int      @default(0)
  edited           Boolean  @default(false)
  createdAt        DateTime @default(now())

  video      Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Comment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]    @relation("CommentThread")
  commentLikes CommentLike[]

  @@index([videoId])
  @@index([userId])
  @@index([videoId, moderation, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  // "like" | "dislike"
  value     String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model Playlist {
  id           String   @id @default(cuid())
  userId       String
  title        String
  // "public" | "unlisted" | "private"
  visibility   String   @default("private")
  isWatchLater Boolean  @default(false)
  createdAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId])
}

model PlaylistItem {
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([playlistId, videoId])
  @@index([videoId])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  sourceChannelId String
  // "video" | "live" | "post" | "reply"
  kind            String   @default("video")
  title           String
  body            String
  videoId         String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceChannel Channel @relation("NotificationSourceChannel", fields: [sourceChannelId], references: [id], onDelete: Cascade)
  video         Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model MembershipTier {
  id         String   @id @default(cuid())
  channelId  String
  name       String
  priceCents Int
  perks      String   @default("")

  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([channelId, name])
}

model Membership {
  userId  String
  tierId  String
  since   DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([userId, tierId])
}

model LiveChatMessage {
  id      String   @id @default(cuid())
  videoId String
  userId  String
  body    String
  at      DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, at])
}

model ThumbnailTest {
  id          String   @id @default(cuid())
  videoId     String
  // JSON string: [{ url, impressions, clicks }]
  variants    String
  winnerIdx   Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model TranscriptCue {
  id       String @id @default(cuid())
  videoId  String
  video    Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  startSec Int
  endSec   Int
  text     String

  @@index([videoId, startSec])
}

model VideoReport {
  id        String   @id @default(cuid())
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

// Personalization / moderation signals — the single kebab-action store.
model VideoSignal {
  id        String   @id @default(cuid())
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "not_interested" | "dont_recommend_channel"
  kind      String
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

// P23-A — WebFlix-local clips (SYNCED from the sqlite schema 2026-10-24: the
// prod variant had drifted — Clip was missing entirely since P23; the P42
// schema-sync law now keeps both variants byte-equivalent modulo provider).
model Clip {
  id        String   @id @default(cuid())
  // the SOURCE video id as the watch surface knows it (a YouTube video id)
  videoId   String
  title     String
  startSec  Int
  endSec    Int
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([videoId])
}

// ---------------------------------------------------------------------------
// P42-NETFLIX-SOURCE — the first second-source lane (ADR 0002). ADDITIVE ONLY.
// NetflixTitle is the catalog MIRROR (the search index the Top 10 pools feed
// on every refresh); NetflixMyListItem is the viewer's WebFlix-LOCAL
// "My Netflix List" (no Netflix credentials anywhere — ADR 0002 §5).
// NOTE: no list primitives — countryRanks is a "CC:rank" CSV.
model NetflixTitle {
  netflixId      Int      @id
  title          String
  // "movie" | "series"
  kind           String
  synopsis       String   @default("")
  releaseYear    Int?
  maturityRating String?
  posterUrl      String?
  backdropUrl    String?
  logoUrl        String?
  weeklyRank     Int?
  allTimeRank    Int?
  weeksInTop10   Int?
  weeklyHoursViewed BigInt?
  weeklyViews    BigInt?
  // YYYY-MM-DD (weekly pools); null = all-time
  weekEndDate    String?
  pool           String?
  isPlayable     Boolean  @default(true)
  // "US:1,GB:4,…" (ISO code → rank in that country's Top 10)
  countryRanks   String   @default("")
  updatedAt      DateTime @updatedAt

  myListItems NetflixMyListItem[]
  watchEvents NetflixWatchEvent[]

  @@index([title])
  @@index([kind])
}

model NetflixMyListItem {
  userId    String
  netflixId Int
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title NetflixTitle @relation(fields: [netflixId], references: [netflixId], onDelete: Cascade)

  @@id([userId, netflixId])
  @@index([userId])
}

// P49-CONTINUE-WATCHING — the viewer's WebFlix-LOCAL play history for Netflix
// titles (ADR 0002 §5: no Netflix credentials anywhere, so playback memory
// lives here, honestly local — the same law as NetflixMyListItem). One row
// per (viewer, title): the hub's "Continue Watching" rail reads it, the
// watch lane's kick and the hand-off deep link write it. playCount is the
// honest "you pressed play N times"; NO fake percent-watched (the streamed
// player gives WebFlix no position, and a fabricated bar would be a lie).
// P51-AUDIT: this model MUST stay in lockstep with prisma/schema.prisma —
// the vercel build pushes THIS file, and a missing model here 502s prod
// (tests/netflix-schema-parity.test.ts pins the lockstep).
model NetflixWatchEvent {
  userId       String
  netflixId    Int
  lastPlayedAt DateTime @default(now())
  playCount    Int      @default(1)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title NetflixTitle @relation(fields: [netflixId], references: [netflixId], onDelete: Cascade)

  @@id([userId, netflixId])
  @@index([userId, lastPlayedAt])
}

// ═══════════════════════════════════════════════════════════════════
// WFX2-LIVE-PLATFORM-1 — first-party WebFlix LIVE (issue #2).
// Frozen Phase 1 contracts (docs/plans/work-orders/WFX2-LIVE-PLATFORM-1.md §6).
// One LiveRoom = one broadcast lifecycle in Phase 1; LiveSession carries the
// provider-scoped transport; participants are identity rows, never
// credentials. Enumerated fields are String (the no-enum SQLite law) with
// allowed values in comments, union-typed in src/lib/live/types.ts.
// Production note: the Vercel build pushes THIS model set to Neon PostgreSQL
// via the schema.postgres.prisma twin (byte-equivalent modulo provider).
// ═══════════════════════════════════════════════════════════════════

// The canonical room identity + policy. status: "idle" | "live" | "ended".
// visibility: "public" | "unlisted" (Phase 1); audience/age gates land later.
model LiveRoom {
  id         String   @id @default(cuid())
  hostId     String
  title      String
  status     String   @default("idle")
  visibility String   @default("public")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host     User          @relation("LiveRoomHost", fields: [hostId], references: [id])
  sessions LiveSession[]
  invites  LiveInvite[]

  @@index([status])
  @@index([hostId])
}

// One scheduled/actual broadcast lifecycle. status: "starting" | "live" |
// "reconnecting" | "ended". providerRoomId is the provider-side room NAME —
// a routing identity, never a secret (tokens are minted server-side).
// endReason: "host" | "provider-webhook" | "timeout" | null while live.
model LiveSession {
  id             String    @id @default(cuid())
  roomId         String
  provider       String    @default("livekit")
  providerRoomId String
  status         String    @default("starting")
  startedAt      DateTime?
  endedAt        DateTime?
  endReason      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room         LiveRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants LiveParticipant[]

  @@unique([provider, providerRoomId])
  @@index([roomId])
  @@index([status])
}

// Session membership for a WebFlix identity. role: "host" | "guest" | "viewer".
// state: "connected" | "disconnected" | "removed". Viewer counts are derived
// from these rows and are APPROXIMATE — never a billing/financial fact.
model LiveParticipant {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  role      String
  state     String   @default("connected")
  joinedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// Host-approved invitation/request state for publisher roles (guests land in
// Phase 3; the table + authorization path freeze now). status: "pending" |
// "accepted" | "declined" | "expired" | "cancelled".
model LiveInvite {
  id        String   @id @default(cuid())
  roomId    String
  inviteeId String
  inviterId String
  role      String   @default("guest")
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([inviteeId, status])
}
