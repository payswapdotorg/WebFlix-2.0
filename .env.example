# WebFlix 2.0 — live YouTube mode (WFX2-A/B and later waves)
# Copy to .env (gitignored) and fill in. Everything is optional: without
# YT_COOKIES the app runs in public mode (search / watch / channel / comments
# live; personalized feeds return YouTube's own logged-out responses).

# The operator's youtube.com session cookies (raw `k=v; k=v; …` header value).
# Required for personalized surfaces: home feed, trending, history
# (continue-watching), subscribe state. NEVER commit this value.
YT_COOKIES=

# InnerTube API key override (defaults to the public WEB key).
INNERTUBE_API_KEY=

# Primary innertube player client for the playback fallback chain
# (streams.ts always tries IOS second unless it IS the primary).
# Vercel egress behavior verified post-deploy.
# Values: WEB (default) / MWEB / WEB_EMBEDDED_PLAYER / WEB_REMIX / IOS
INNER_TUBE_PLAYER_CLIENT=

# --- WFX2-C-W production wiring (Vercel) — NAMES only, values live in the
# --- Vercel project settings. See docs/ops/vercel-env.md for the runbook. ---

# Neon Postgres (Prisma DATABASE_URL) — the production database.
# DATABASE_URL=

# Upstash Redis (REST) — the shared cache + rate-limit adapter. Absent → the
# app falls back to per-instance in-memory caching (dev + tests).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# The Tier-2 write broker (mini-services/youtube-broker) — authenticated
# YouTube actions (comments, likes, subscriptions, playlists).
# BROKER_URL=          # default http://127.0.0.1:3055 (the direct local broker)
# Public-gateway form: the sandbox's FC gateway in front of the broker needs
# its routing query on EVERY request (the client always sends the required
# x-session-id header). Either embed the query in the base or set BROKER_QUERY:
# BROKER_URL=https://<public-host>
# BROKER_QUERY=XTransformPort=3055   # appended as ?… to every broker request
# BROKER_SECRET=       # shared secret (must match the broker's BROKER_SECRET)

# --- WFX2-P2-AU — the WebFlix auth system (NextAuth v4) ---

# The JWT session signing secret. REQUIRED in production — generate with
# `openssl rand -base64 32`. Dev + tests run env-clean on an insecure
# local fallback (wf-dev-… — see src/lib/auth/secret.ts). NEVER commit
# the real value.
NEXTAUTH_SECRET=

# The canonical origin (auto-derived on Vercel from VERCEL_URL; set it
# explicitly for other deployments, e.g. https://webflix.example.com).
NEXTAUTH_URL=


# The standalone Creator Studio (apps/studio) — the /studio redirect target
# (youtube.com/studio → studio.youtube.com parity). Default when unset:
# https://studio-webflix.vercel.app
STUDIO_APP_URL=
