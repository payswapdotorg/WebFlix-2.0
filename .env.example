# WebFlix 2.0 — live YouTube mode (WFX2-A/B and later waves)
# Copy to .env (gitignored) and fill in. Everything is optional: without
# YT_COOKIES the app runs in public mode (search / watch / channel / comments
# live; personalized feeds return YouTube's own logged-out responses).

# The operator's youtube.com session cookies (raw `k=v; k=v; …` header value).
# Required for personalized surfaces: home feed, trending, history
# (continue-watching), subscribe state. NEVER commit this value.
YT_COOKIES=

# InnerTube API key override (defaults to the public WEB key).
INNERTUBE_API_KEY=
